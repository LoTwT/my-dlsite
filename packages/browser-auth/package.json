{
  "name": "@my-dlsite/browser-auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@my-dlsite/core": "workspace:*",
    "playwright": "1.65.0"
  },
  "devDependencies": {
    "@types/node": "24.11.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.11"
  }
}
