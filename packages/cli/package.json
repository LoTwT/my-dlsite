{
  "name": "@my-dlsite/cli",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "my-dlsite": "./dist/bin.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@my-dlsite/browser-auth": "workspace:*",
    "@my-dlsite/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.11.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.11"
  }
}
