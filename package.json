{
  "name": "my-dlsite-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for the my-dlsite project.",
  "license": "MIT",
  "author": "LoTwT <l709937065@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoTwT/my-dlsite.git"
  },
  "type": "module",
  "scripts": {
    "deps": "taze -r latest -I -f",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "simple-git-hooks": "^2.14.0",
    "taze": "^21.3.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm format:check"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
